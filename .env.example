# =============================================================================
# PLACEHOLDERS ONLY — this file is documentation, not configuration.
# =============================================================================
# Real credentials NEVER live in this repository. Keep actual secrets in an
# env file outside the repo (e.g. ~/.config/supertrademan/env or your secret
# manager) and load it into the environment before `docker compose up` /
# running the services. Compose manifests use ${VAR:?err} interpolation and
# refuse to start with these unset — that fail-closed behavior is intentional.
#
# Generate strong secrets with:  openssl rand -base64 32
# =============================================================================

# --- Database / cache (used by docker-compose.yml) ---------------------------
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASS
POSTGRES_DB=DB
REDIS_PASSWORD=PASS

# --- Application connection strings (used by src/trading/config.py) ---------
# Format examples only — substitute real values from your external secret store.
POSTGRES_URL=postgresql://USER:PASS@localhost:5432/DB
REDIS_URL=redis://:PASS@localhost:6379/0

# --- Monitoring (used by monitoring/docker-compose.yml) ----------------------
GRAFANA_ADMIN_PASSWORD=PASS

# --- Observability endpoint auth ---------------------------------------------
# If unset, the metrics endpoint DISABLES ITSELF (deny-all). No default token.
METRICS_BEARER_TOKEN=TOKEN

# --- Exchange / alerting credentials (SecretsManager reads these) ------------
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
